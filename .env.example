# Provider keys - only needed for the provider(s) you actually use; all
# optional when running with --offline / OFFLINE=true.
GROQ_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FAL_API_KEY=

# Server (app/server/config.py) - docker-compose.yml sets MONGO_URL/REDIS_URL/
# JOBS_DIR/OFFLINE itself; only uncomment here to override those for local
# (non-compose) runs, or to set the rest.
# MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=video_pipeline
# REDIS_URL=redis://redis:6379
# JOBS_DIR=output
# OFFLINE=false
JOB_TIMEOUT_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]
API_TOKEN=
MAX_JOBS=
